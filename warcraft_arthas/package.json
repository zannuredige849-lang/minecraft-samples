{
  "name": "warcraft-arthas-addon",
  "version": "0.1.0",
  "private": true,
  "description": "Warcraft: Arthas Menethil, Frostmourne and the Enslavement of Souls - Minecraft Bedrock add-on",
  "type": "module",
  "scripts": {
    "gen": "python3 tools/gen/build_all.py",
    "typecheck": "tsc -p tools/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "validate": "node tools/validate/validate_addon.mjs",
    "preview": "node tools/preview/render_previews.mjs",
    "build": "python3 tools/build_mcaddon.py"
  },
  "devDependencies": {
    "@minecraft/server": "2.0.0",
    "@minecraft/server-ui": "2.0.0",
    "@minecraft/vanilla-data": "^1.21.0",
    "three": "0.160.0",
    "typescript": "^5.6.0"
  }
}
