{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "cb:ares",
   "materials": {
    "default": "entity_emissive_alpha"
   },
   "textures": {
    "default": "textures/entity/ares"
   },
   "geometry": {
    "default": "geometry.cb_ares"
   },
   "animations": {
    "idle": "animation.ares.idle",
    "walk": "animation.ares.walk",
    "attack": "animation.ares.attack",
    "special_attack": "animation.ares.special_attack",
    "hurt": "animation.ares.hurt",
    "death": "animation.ares.death",
    "charge": "animation.ares.shield_bash",
    "special1": "animation.ares.shield_bash",
    "special2": "animation.ares.spear_charge",
    "special3": "animation.ares.war_fury",
    "stun": "animation.ares.stun",
    "rage": "animation.ares.rage",
    "dance": "animation.ares.dance",
    "ctrl": "controller.animation.cb_ares",
    "look_at_target": "animation.common.look_at_target"
   },
   "scripts": {
    "animate": [
     {
      "idle": "!q.property('cb:dancing')"
     },
     {
      "walk": "q.modified_move_speed > 0.015 && !q.property('cb:dancing') && !q.property('cb:charging')"
     },
     {
      "rage": "q.property('cb:enraged') && !q.property('cb:dancing')"
     },
     {
      "hurt": "q.hurt_time > 0 && !q.property('cb:dancing')"
     },
     "ctrl",
     {
      "look_at_target": "!q.property('cb:dancing') && q.property('cb:cast_state') == 0"
     }
    ]
   },
   "render_controllers": [
    "controller.render.cb_ares"
   ],
   "spawn_egg": {
    "base_color": "#a7050a",
    "overlay_color": "#40c8e0"
   }
  }
 }
}