{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "cb:fel_lord",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/fel_lord"
      },
      "geometry": {
        "default": "geometry.cb_fel_lord"
      },
      "animations": {
        "idle": "animation.fel_lord.idle",
        "walk": "animation.fel_lord.walk",
        "attack": "animation.fel_lord.attack",
        "special_attack": "animation.fel_lord.special_attack",
        "hurt": "animation.fel_lord.hurt",
        "death": "animation.fel_lord.death",
        "charge": "animation.fel_lord.charge",
        "special1": "animation.fel_lord.summon_demons",
        "special2": "animation.fel_lord.green_flame",
        "special3": "animation.fel_lord.phase2_transform",
        "stun": "animation.fel_lord.stun",
        "rage": "animation.fel_lord.rage",
        "dance": "animation.fel_lord.dance",
        "ctrl": "controller.animation.cb_fel_lord",
        "look_at_target": "animation.common.look_at_target"
      },
      "scripts": {
        "animate": [
          {
            "idle": "!q.property('cb:dancing')"
          },
          {
            "walk": "q.modified_move_speed > 0.015 && !q.property('cb:dancing') && !q.property('cb:charging')"
          },
          {
            "rage": "q.property('cb:enraged') && !q.property('cb:dancing')"
          },
          {
            "hurt": "q.hurt_time > 0 && !q.property('cb:dancing')"
          },
          "ctrl",
          {
            "look_at_target": "!q.property('cb:dancing') && q.property('cb:cast_state') == 0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.cb_fel_lord"
      ],
      "spawn_egg": {
        "texture": "cb_egg_fel_lord"
      }
    }
  }
}