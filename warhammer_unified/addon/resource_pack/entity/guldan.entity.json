        "walk": "animation.guldan.walk",
        "cast_orb": "animation.guldan.cast_orb",
        "drain": "animation.guldan.drain",
        "cast_curse": "animation.guldan.cast_curse",
        "rain_prep": "animation.guldan.rain_prep",
        "hurt": "animation.guldan.hurt",
        "dance": "animation.guldan.dance",
        "look_at_target": "animation.common.look_at_target",
        "ctrl": "controller.animation.guldan",
        "fel_nova": "animation.guldan.fel_nova",
        "chain_fel": "animation.guldan.chain_fel",
        "cast_meteor": "animation.guldan.cast_meteor"
      },
      "scripts": {
        "animate": [
          "ctrl",
          "look_at_target",
          {
