        },
        "minecraft:herd": {
          "min_size": 1,
          "max_size": 1
        },
        "minecraft:density_limit": {
          "underground": 2
        },
        "minecraft:brightness_filter": {
          "min": 0,
          "max": 7,
          "adjust_for_weather": false
        },
        "minecraft:height_filter": {
          "min": -16,
          "max": 256
        },
        "minecraft:biome_filter": {
          "any_of": [
            {
              "test": "has_biome_tag",
              "value": "extreme_hills"
            },
            {
              "test": "has_biome_tag",
              "value": "mountains"
            },
            {
              "test": "has_biome_tag",
              "value": "mountain"
            }
          ]
        }
      }
    ]
  }
}