{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "cb:siren",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "cb:variant": {
          "type": "int",
          "range": [
            0,
            5
          ],
          "default": 0,
          "client_sync": true
        },
        "cb:sing": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "cb:angry": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "cb:dancing": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "cb:calm": {
        "minecraft:behavior.random_swim": {
          "priority": 5,
          "interval": 40,
          "xz_dist": 12,
          "avoid_surface": false
        },
        "minecraft:behavior.look_at_player": {
          "priority": 7,
          "look_distance": 16,
          "probability": 0.08
        },
        "minecraft:behavior.move_to_water": {
          "priority": 3,
          "search_range": 15,
          "search_height": 5
        }
      },
      "cb:hunting": {
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "must_see": false,
          "reselect_targets": true,
          "within_radius": 16,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "f_sea"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "value": "cb_siren_prey"
                  }
                ]
              },
              "max_dist": 16
            }
          ]
        },
        "minecraft:behavior.hurt_by_target": {
          "priority": 1,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "f_sea"
                  }
                ]
              },
              "max_dist": 64
            }
          ]
        },
        "minecraft:behavior.melee_attack": {
          "priority": 2,
          "speed_multiplier": 1.6,
          "track_target": true,
          "require_complete_path": false
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "siren",
          "siren_faction",
          "merfolk",
          "monster",
          "mob",
          "f_sea",
          "summon_safe"
        ]
      },
      "minecraft:health": {
        "value": 25,
        "max": 25
      },
      "minecraft:collision_box": {
        "width": 0.8,
        "height": 1.8
      },
      "minecraft:breathable": {
        "breathes_water": true,
        "breathes_air": true,
        "total_supply": 15,
        "suffocate_time": 0,
        "generates_bubbles": false
      },
      "minecraft:movement": {
        "value": 0.1035
      },
      "minecraft:underwater_movement": {
        "value": 0.23
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.generic": {
        "is_amphibious": true,
        "can_path_over_water": false,
        "can_swim": true,
        "can_walk": true,
        "can_breach": true,
        "can_sink": false
      },
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:nameable": {},
      "minecraft:persistent": {},
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": {
                "any_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "siren_faction"
                  }
                ]
              }
            },
            "deals_damage": false
          },
          {
            "cause": "fall",
            "deals_damage": false
          }
        ]
      },
      "minecraft:ambient_sound_interval": {
        "value": 14,
        "range": 14,
        "event_name": "ambient"
      },
      "minecraft:attack": {
        "damage": 3
      },
      "minecraft:follow_range": {
        "value": 24,
        "max": 24
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 10 : 0"
      },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "test": "is_riding",
              "subject": "self",
              "value": true
            },
            "event": "cb:leave_boat"
          }
        ]
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "set_property": {
          "cb:variant": "math.random_integer(0, 5)"
        },
        "add": {
          "component_groups": [
            "cb:calm"
          ]
        }
      },
      "cb:hunt": {
        "set_property": {
          "cb:angry": true,
          "cb:sing": false
        },
        "remove": {
          "component_groups": [
            "cb:calm"
          ]
        },
        "add": {
          "component_groups": [
            "cb:hunting"
          ]
        }
      },
      "cb:calm_down": {
        "set_property": {
          "cb:angry": false
        },
        "remove": {
          "component_groups": [
            "cb:hunting"
          ]
        },
        "add": {
          "component_groups": [
            "cb:calm"
          ]
        }
      },
      "cb:leave_boat": {
        "queue_command": {
          "command": [
            "ride @s stop_riding"
          ]
        }
      }
    }
  }
}